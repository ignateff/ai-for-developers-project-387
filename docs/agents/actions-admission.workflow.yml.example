# Documentation only: NOT an enabled workflow. Never add a model step to this template.
name: Metadata admission experiment
on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
permissions:
  contents: read
  actions: read
  pull-requests: read
  issues: read
jobs:
  metadata:
    # This convention is provisional, not authenticated historical provenance.
    name: budget-model / ${{ github.event_name == 'pull_request' && 'review' || 'command' }} / pr-${{ github.event.issue.number || github.event.pull_request.number }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          # Never execute code from an untrusted PR head.
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: 24
      - name: inspect (always fails closed)
        id: inspect
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
          ADMISSION_WORKFLOW_ID: ${{ vars.ADMISSION_WORKFLOW_ID }}
          ADMISSION_BOUNDARY_RUN_ID: ${{ vars.ADMISSION_BOUNDARY_RUN_ID }}
        run: node scripts/actions-gate-cli.ts
      # A successful marker is only simulated accounting metadata, never authorization.
      - name: admission
        if: ${{ steps.inspect.outputs.metadata_candidate == 'would-admit' }}
        run: echo "Metadata-only hypothetical marker; no model access"
      - name: fail closed
        if: ${{ always() }}
        run: exit 1
