{
  "$schema": "https://unpkg.com/knip@6.44.1/schema.json",
  "ignoreIssues": {
    "generated/sdk/client.ts": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "ignoreBinaries": [
        "mise",
        "hk",
        "pitchfork",
        "jactionlint",
        "shellcheck",
        "hadolint",
        "betterleaks",
        "osv-scanner"
      ],
      "ignoreDependencies": ["@typespec/http", "@typespec/openapi3"],
      "entry": ["scripts/dev-target.mjs"],
      "project": ["**/*.{js,mjs,cjs,ts,mts,cts,tsx}"],
      "orval": { "config": ["contract/orval.config.ts"] },
      "playwright": { "config": ["playwright.config.ts"] },
      "vitest": { "config": ["vitest.config.ts"] }
    },
    "apps/api": {
      "entry": ["test-support/booking-worker.ts"],
      "project": ["**/*.{js,mjs,cjs,ts,mts,cts,tsx}"]
    },
    "apps/web": {
      "project": ["**/*.{js,mjs,cjs,ts,mts,cts,tsx}"],
      "vite": { "config": ["vite.config.ts"] }
    }
  }
}
