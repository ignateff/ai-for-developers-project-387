{
  "name": "call-calendar",
  "private": true,
  "type": "module",
  "scripts": {
    "check:quick": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "deps:update": "pnpm update -r",
    "check:files": "hk check --all --check",
    "check:push": "pnpm run check:quick && pnpm run lint:unused && pnpm run lint:workflows && pnpm run lint:shell && pnpm run lint:docker && pnpm run check:secrets && pnpm run check:commits",
    "lint": "oxlint --deny-warnings apps",
    "lint:unused": "knip",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "lint:shell": "shellcheck scripts/*.sh",
    "lint:docker": "hadolint --failure-threshold style Dockerfile",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:vulnerabilities": "node scripts/check-vulnerabilities.mjs",
    "check:security": "pnpm run lint:workflows && pnpm run check:secrets && pnpm run check:vulnerabilities",
    "check:commits": "node scripts/check-commits.mjs",
    "lint:commit-message": "commitlint --strict --edit",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:skills-integrity": "node scripts/check-matt-skills.mjs && vitest run scripts/matt-skills-integrity.test.ts",
    "test:opencode-runtime": "node scripts/opencode-runtime-regression.mjs",
    "test:opencode-review-runtime": "node scripts/opencode-review-runtime.mjs",
    "opencode:install": "node scripts/opencode-install.ts",
    "opencode:trust": "node scripts/opencode-trust.ts",
    "opencode:budget": "node scripts/opencode-budget-cli.ts",
    "opencode:review-prepare": "node scripts/opencode-review-workflow.ts prepare",
    "opencode:review-run": "node scripts/opencode-review-workflow.ts run",
    "opencode:review-publish": "node scripts/opencode-review-publish-cli.ts",
    "opencode:prepare": "node scripts/opencode-command.ts prepare",
    "opencode:run": "node scripts/opencode-command.ts run",
    "opencode:log-summary": "node scripts/opencode-log-summary.ts",
    "lint:opencode-workflow": "jactionlint .github/workflows/opencode.yml",
    "lint:opencode-review-workflow": "jactionlint .github/workflows/opencode-review.yml",
    "lint:triage-workflow": "jactionlint .github/workflows/opencode-triage.yml",
    "build": "pnpm -r --if-present build",
    "build:docker": "node scripts/build-docker.mjs",
    "test:docker-smoke": "node scripts/docker-smoke.ts",
    "deploy:prepare": "node scripts/deploy-prepare.mjs",
    "deploy:fly": "node scripts/deploy-fly.mjs",
    "generate": "tsp compile contract/main.tsp && orval --config contract/orval.config.ts",
    "check:generated": "node scripts/check-generated.mjs",
    "db:generate": "pnpm --filter @calendar/api db:generate",
    "db:migrate": "pnpm --filter @calendar/api db:migrate",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:visual:update": "playwright test e2e/00-visual.spec.ts --update-snapshots",
    "test:e2e:visual:update:linux": "bash scripts/update-visual-snapshots-linux.sh",
    "check:contract-http": "node scripts/check-contract-http.mjs",
    "opencode:actions-budget": "node scripts/opencode-actions-budget.ts"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.10",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "knip": "6.44.1",
    "openapi-backend": "5.23.0",
    "orval": "8.45.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@scalar/json-magic@0.13.5>undici": "7.30.1"
    }
  }
}
